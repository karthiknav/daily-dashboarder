# Azure DevOps
ADO_ORG_URL="https://dev.azure.com/<org>"
ADO_PAT="<personal-access-token>"
GIT_USER_NAME="daily-dashboard-bot"
GIT_USER_EMAIL="daily-dashboard-bot@example.com"

# Azure OpenAI (same convention as yapl-upgrader)
AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<key>"
AZURE_OPENAI_VERSION="2024-05-01-preview"
AZURE_OPENAI_DEPLOYMENT="gpt-5"

# Microsoft Graph (announcements mailbox) - optional; scan runs with an empty
# announcements list if these aren't set. App registration needs the
# application (not delegated) Mail.Read permission, admin-consented, scoped
# to MS_GRAPH_MAILBOX via an application access policy.
MS_GRAPH_TENANT_ID="<tenant-id>"
MS_GRAPH_CLIENT_ID="<app-registration-client-id>"
MS_GRAPH_CLIENT_SECRET="<client-secret>"
MS_GRAPH_MAILBOX="announcements@example.com"
MS_GRAPH_MAIL_FOLDER="inbox"
ANNOUNCEMENTS_LOOKBACK_HOURS="24"
